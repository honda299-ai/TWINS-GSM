rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // الأدمن الأساسي (Honda Store) + أي شريك مضاف في مجموعة admins
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.email == 'hondastore299@gmail.com' && request.auth.token.email_verified == true) ||
        (request.auth.token.email_verified == true && exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.active == true)
      );
    }
    function notBlocked() {
      return request.auth != null && !(exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('blocked', false) == true);
    }
    // السوبر أدمن: صاحب الموقع فقط. الشريك ماينفعش يحظر أو يحذف السوبر أدمن أو أي شريك تاني.
    function isSuper() {
      return request.auth != null && request.auth.token.email == 'hondastore299@gmail.com' && request.auth.token.email_verified == true;
    }
    function isProtected() {
      return resource.data.get('email', '') == 'hondastore299@gmail.com' ||
        (resource.data.get('email', '') != '' && exists(/databases/$(database)/documents/admins/$(resource.data.get('email', ''))));
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // محتوى الموقع: قراءة للجميع، تعديل للأدمن والشركاء
    match /stats/{doc}                 { allow read: if true; allow write: if isAdmin(); }
    match /services/{doc}              { allow read: if true; allow write: if isAdmin(); }
    match /steps/{doc}                 { allow read: if true; allow write: if isAdmin(); }
    match /works/{doc}                 { allow read: if true; allow write: if isAdmin(); }
    match /workCategories/{doc}        { allow read: if true; allow write: if isAdmin(); }
    match /tools/{doc}                 { allow read: if true; allow write: if isAdmin(); }
    match /toolCategories/{doc}        { allow read: if true; allow write: if isAdmin(); }
    match /testimonials/{doc}          { allow read: if true; allow write: if isAdmin(); }
    match /faqs/{doc}                  { allow read: if true; allow write: if isAdmin(); }
    match /site/{doc}                  { allow read: if true; allow write: if isAdmin(); }

    // مكتبة الصور: للأدمن والشركاء فقط
    match /media/{doc}                 { allow read, write: if isAdmin(); }

    // الشركاء: الأدمن الأساسي فقط يقدر يضيف/يمسح شريك
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if request.auth != null && request.auth.token.email == 'hondastore299@gmail.com' && request.auth.token.email_verified == true;
    }

    // بيانات خاصة بكل مستخدم
    // العضوية: العضو يقرأ بس، والأدمن يكتب. بتنتهي تلقائياً بمقارنة expiresAt بوقت السيرفر.
    function hasPro() {
      return request.auth != null && request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/memberships/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.level == 'pro' &&
        get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.expiresAt > request.time && notBlocked();
    }
    // أكواد التفعيل: التفعيل الذاتي بيتحقق بالكامل من السيرفر (الكود صالح + العداد +1 + المدة مضبوطة)
    function codeRef() { return /databases/$(database)/documents/proCodes/$(request.resource.data.redeemedCode); }
    function baseTime(uid) {
      return (exists(/databases/$(database)/documents/memberships/$(uid)) &&
        get(/databases/$(database)/documents/memberships/$(uid)).data.get('expiresAt', request.time) > request.time)
        ? get(/databases/$(database)/documents/memberships/$(uid)).data.expiresAt : request.time;
    }
    function redeemOk(uid) {
      return isOwner(uid) && request.auth.token.email_verified == true && notBlocked()
        && request.resource.data.level == 'pro' && request.resource.data.active == true
        && request.resource.data.redeemedCode is string
        && exists(codeRef())
        && get(codeRef()).data.active == true
        && get(codeRef()).data.used < get(codeRef()).data.maxUses
        && (get(codeRef()).data.get('expiresAt', null) == null || get(codeRef()).data.expiresAt > request.time)
        && getAfter(codeRef()).data.used == get(codeRef()).data.used + 1
        && getAfter(/databases/$(database)/documents/redemptions/$(request.resource.data.redeemedCode + '_' + uid)).data.uid == uid
        && request.resource.data.expiresAt <= baseTime(uid) + duration.value(get(codeRef()).data.days, 'd') + duration.value(1, 'd');
    }
    match /proCodes/{code} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.auth != null && notBlocked() && request.auth.token.email_verified == true
        && resource.data.active == true && resource.data.used < resource.data.maxUses
        && request.resource.data.used == resource.data.used + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'lastUsedBy'])
        && request.resource.data.lastUsedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.redeemedCode == code);
    }
    match /redemptions/{rid} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && rid == request.resource.data.code + '_' + request.auth.uid;
      allow update, delete: if false;
    }
    match /memberships/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isAdmin() || redeemOk(uid);
      allow delete: if isAdmin();
    }
    match /proVault/{id} {
      allow read: if isAdmin() || hasPro() || (resource.data.get('forAll', false) == true && request.auth != null && request.auth.token.email_verified == true && notBlocked());
      allow write: if isAdmin();
    }

    // التعليقات: تظهر للزوار بعد موافقتك فقط
    match /comments/{id} {
      allow read: if isAdmin() || resource.data.status == 'approved' || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null && notBlocked() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.text is string && request.resource.data.text.size() >= 5 && request.resource.data.text.size() <= 400
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isSuper() || (isAdmin() && request.resource.data.get('email', '') != 'hondastore299@gmail.com') || (isOwner(uid) && request.resource.data.role == 'member' && !('blocked' in request.resource.data));
      allow update: if isSuper() || (isAdmin() && !isProtected()) || (isOwner(uid) && request.resource.data.role == resource.data.role && request.resource.data.get('blocked', false) == resource.data.get('blocked', false));
      allow delete: if isSuper() || (isAdmin() && !isProtected());
    }

    match /downloads/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && notBlocked();
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    match /requests/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'جديد' && notBlocked();
      // العميل يقدر يحدّث مؤشرات المحادثة فقط (مش الحالة ولا بيانات الطلب)
      allow update: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastFrom', 'lastMessageAt', 'lastText', 'unreadAdmin', 'unreadCustomer', 'rating', 'ratingNote'])
        && (request.resource.data.get('rating', 0) == resource.data.get('rating', 0) || (resource.data.status == 'تم التنفيذ' && !('rating' in resource.data) && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5)));
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // محادثة الطلب: العميل صاحب الطلب + الأدمن فقط. الرسائل ماتتعدّلش.
    match /requests/{id}/messages/{mid} {
      allow read: if isAdmin() || (request.auth != null && get(/databases/$(database)/documents/requests/$(id)).data.uid == request.auth.uid);
      allow create: if request.auth != null && notBlocked()
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && (request.resource.data.text.size() >= 1 || request.resource.data.get('image', '') != '')
        && (request.resource.data.get('image', '') == '' || (request.resource.data.image is string && request.resource.data.image[0:11] == 'data:image/' && request.resource.data.image.size() < 220000))
        && ((isAdmin() && request.resource.data.from == 'admin')
          || (request.resource.data.from == 'customer' && request.resource.data.uid == request.auth.uid
              && get(/databases/$(database)/documents/requests/$(id)).data.uid == request.auth.uid));
      allow update: if false;
      allow delete: if isAdmin();
    }

    // سجل النشاط: إضافة فقط من الأدمن، والقراءة للأدمن
    match /activity/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.by == request.auth.token.email;
      allow update, delete: if false;
    }

    // السوبر أدمن: صلاحية كاملة (قراءة/كتابة/حذف) على كل حاجة حالية ومستقبلية
    match /{document=**} {
      allow read, write: if isSuper();
    }
  }
}
